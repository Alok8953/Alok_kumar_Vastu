PORT=5000
# Dev: http://localhost:5173 | Production: https://yourdomain.com
FRONTEND_ORIGIN=http://localhost:5173

# Production only — serve built frontend from Express (single-domain deploy)
# SERVE_FRONTEND=true
# NODE_ENV=production

# PostgreSQL — Neon (recommended) or local Docker
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require

# Local Docker only (when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=vastu_db

# Email — Resend (production) or Gmail (local dev)
# Sign up: https://resend.com
RESEND_API_KEY=
RESEND_FROM=Vastu Website <onboarding@resend.dev>
TO_EMAIL=alokkmishra06@gmail.com

# Public backend URL (for approve/reject links in review emails)
BACKEND_PUBLIC_URL=https://vastualok.com

# Gmail — local dev fallback only
GMAIL_USER=alokkmishra06@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here

# Review approvals (admin panel at /#admin/reviews)
ADMIN_API_KEY=change-this-to-a-long-secret-key

# Review phone OTP (Fast2SMS). Without key, use OTP_DEBUG=true for local testing.
# FAST2SMS_API_KEY=
OTP_DEBUG=true
