PORT=5000
# Dev: http://localhost:5173 | Production: https://yourdomain.com
FRONTEND_ORIGIN=http://localhost:5173

# Production only — serve built frontend from Express (single-domain deploy)
# SERVE_FRONTEND=true
# NODE_ENV=production

# PostgreSQL — Neon / Render / Railway (recommended)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require

# Local Docker only (when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=vastu_db

# Gmail (required for form submission — emails go to TO_EMAIL)
GMAIL_USER=alokkmishra06@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here
TO_EMAIL=alokkmishra06@gmail.com

# Review approvals (admin panel at /#admin/reviews)
ADMIN_API_KEY=change-this-to-a-long-secret-key
